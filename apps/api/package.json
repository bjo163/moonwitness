{
  "name": "api",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "predev": "pnpm --filter \"@moon/*\" build",
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:install": "tsx src/migrate.ts install",
    "db:migrate": "tsx src/migrate.ts up",
    "db:diff:additive": "tsx src/migrate.ts diff:additive",
    "db:bootstrap": "tsx src/migrate.ts bootstrap",
    "db:check": "tsx src/migrate.ts check",
    "db:seed": "tsx src/migrate.ts seed",
    "db:demo": "tsx src/migrate.ts demo",
    "db:verify": "tsx src/migrate.ts verify",
    "certify:witness-graph-pg": "tsx src/certify-witness-graph-pg.ts",
    "test": "vitest run",
    "audit:rules": "node ../../scripts/audit-rules.mjs",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,js,json}\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@moon/base": "workspace:*",
    "@moon/client": "workspace:*",
    "@moon/compute": "workspace:*",
    "@moon/orm": "workspace:*",
    "@moon/performance": "workspace:*",
    "@moon/project": "workspace:*",
    "@moon/helpdesk": "workspace:*",
    "@moon/server": "workspace:*",
    "@moon/witness": "workspace:*",
    "@moon/khidra": "workspace:*",
    "@moon/mizan": "workspace:*",
    "@moon/shootgun": "workspace:*",
    "@moon/cab": "workspace:*",
    "@moon/product": "workspace:*",
    "@moon/stock": "workspace:*",
    "@moon/account": "workspace:*",
    "@moon/crm": "workspace:*",
    "@moon/mail": "workspace:*",
    "@moon/geo": "workspace:*",
    "@moon/cron": "workspace:*",
    "@moon/protocol": "workspace:*",
    "dotenv": "^16.4.5",
    "knex": "^3.0.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/eventsource": "^3.0.0",
    "@types/node": "^26.1.2",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^9",
    "eventsource": "^4.1.0",
    "tsx": "^4.7.0",
    "typescript": "^5.5.4"
  }
}
