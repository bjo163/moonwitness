{
  "name": "api",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "predev": "pnpm --filter \"@moon/*\" build",
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "certify:witness-graph-pg": "tsx src/certify-witness-graph-pg.ts",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,js,json}\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@moon/base": "workspace:*",
    "@moon/client": "workspace:*",
    "@moon/orm": "workspace:*",
    "@moon/performance": "workspace:*",
    "@moon/server": "workspace:*",
    "@moon/witness": "workspace:*",
    "@moon/khidra": "workspace:*",
    "@moon/mizan": "workspace:*",
    "@moon/shootgun": "workspace:*",
    "@moon/cab": "workspace:*",
    "dotenv": "^16.4.5",
    "knex": "^3.0.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/eventsource": "^3.0.0",
    "@types/node": "^26.1.2",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^9",
    "eventsource": "^4.1.0",
    "tsx": "^4.7.0",
    "typescript": "^5.5.4"
  }
}
