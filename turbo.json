{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalEnv": ["NODE_ENV", "NEXT_PUBLIC_*", "PORT", "VERCEL_URL", "DATABASE_URL", "JWT_SECRET", "API_PORT", "WEB_PORT", "COMMAND_CENTER_PORT", "CELESTIAL_ENGINE_PORT", "AI_AGENT_PORT", "TEST_DATABASE_URL", "SMTP_SERVICE", "SMTP_USER", "SMTP_PASS", "SMTP_FROM", "EMAIL_SERVICE", "EMAIL_USER", "EMAIL_PASS", "EMAIL_FROM"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
