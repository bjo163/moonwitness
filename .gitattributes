# ◈ MOONWITNESS OS — CANONICAL GIT ATTRIBUTES & LINE ENDING NORMALIZATION
# Auto-detect text files and normalize line endings to LF on checkout/commit

* text=auto eol=lf

# Explicit text file formats
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.css text eol=lf
*.html text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.sql text eol=lf

# Binary media & font files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.svg text eol=lf
*.ico binary
*.pdf binary
*.ttf binary
*.woff binary
*.woff2 binary
*.eot binary
*.mp3 binary
*.wav binary
