<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mizan_assessment_list" model="ir.ui.view">
        <field name="name">moon.mizan.assessment.list</field>
        <field name="model">moon.mizan.assessment</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="profile_id"/>
                <field name="source_revision"/>
                <field name="method"/>
                <field name="total_weight"/>
                <field name="state"/>
                <field name="score_available"/>
            </list>
        </field>
    </record>

    <record id="view_mizan_assessment_form" model="ir.ui.view">
        <field name="name">moon.mizan.assessment.form</field>
        <field name="model">moon.mizan.assessment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_evaluate" type="object" string="Evaluate" class="oe_highlight" invisible="state not in ('draft','in_review')"/>
                    <button name="action_submit_review" type="object" string="Submit for review" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="profile_id"/>
                        <field name="source_revision"/>
                        <field name="case_id"/>
                        <field name="regulation_id"/>
                        <field name="assessor_id"/>
                    </group>
                    <group>
                        <field name="method"/>
                        <field name="general_sufficient"/>
                        <field name="balance_state"/>
                        <field name="general_weight"/>
                        <field name="reference_weight"/>
                        <field name="total_weight"/>
                        <field name="score_max"/>
                        <field name="score_available"/>
                        <field name="rating"/>
                    </group>
                    <notebook>
                        <page string="Criteria">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="criterion_id"/>
                                    <field name="answer"/>
                                    <field name="score"/>
                                    <field name="score_available"/>
                                    <field name="reason"/>
                                </list>
                            </field>
                        </page>
                        <page string="Conclusion">
                            <field name="limitation"/>
                            <field name="conclusion"/>
                            <field name="recommended_action"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mizan_assessment" model="ir.actions.act_window">
        <field name="name">Mizan Assessments</field>
        <field name="res_model">moon.mizan.assessment</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_mizan_case_list" model="ir.ui.view">
        <field name="name">moon.mizan.case.list</field>
        <field name="model">moon.mizan.case</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="company_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="action_mizan_case" model="ir.actions.act_window">
        <field name="name">Mizan Cases</field>
        <field name="res_model">moon.mizan.case</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_mizan_regulation_list" model="ir.ui.view">
        <field name="name">moon.mizan.regulation.list</field>
        <field name="model">moon.mizan.regulation</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="document_key"/>
                <field name="revision"/>
                <field name="state"/>
                <field name="legal_status"/>
            </list>
        </field>
    </record>

    <record id="action_mizan_regulation" model="ir.actions.act_window">
        <field name="name">Mizan Regulations</field>
        <field name="res_model">moon.mizan.regulation</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_mizan_reference_list" model="ir.ui.view">
        <field name="name">moon.mizan.reference.list</field>
        <field name="model">moon.mizan.reference</field>
        <field name="arch" type="xml">
            <list>
                <field name="assessment_id"/>
                <field name="source_policy_key"/>
                <field name="source_revision"/>
                <field name="epistemic_status"/>
                <field name="verified"/>
            </list>
        </field>
    </record>

    <record id="action_mizan_reference" model="ir.actions.act_window">
        <field name="name">References</field>
        <field name="res_model">moon.mizan.reference</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_mizan_engine_run_list" model="ir.ui.view">
        <field name="name">moon.mizan.engine.run.list</field>
        <field name="model">moon.mizan.engine.run</field>
        <field name="arch" type="xml">
            <list>
                <field name="request_key"/>
                <field name="assessment_id"/>
                <field name="state"/>
                <field name="source_revision"/>
            </list>
        </field>
    </record>

    <record id="action_mizan_engine_run" model="ir.actions.act_window">
        <field name="name">Engine Runs</field>
        <field name="res_model">moon.mizan.engine.run</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_mizan_root" name="Revelation–Mizan" sequence="57" groups="base.group_user" web_icon="moon_mizan,static/description/icon.png"/>
    <menuitem id="menu_mizan_assessment" name="Assessments" parent="menu_mizan_root" action="action_mizan_assessment"/>
    <menuitem id="menu_mizan_case" name="Cases" parent="menu_mizan_root" action="action_mizan_case"/>
    <menuitem id="menu_mizan_regulation" name="Regulations" parent="menu_mizan_root" action="action_mizan_regulation"/>
    <menuitem id="menu_mizan_reference" name="References" parent="menu_mizan_root" action="action_mizan_reference"/>
    <menuitem id="menu_mizan_engine_run" name="Engine Runs" parent="menu_mizan_root" action="action_mizan_engine_run"/>
</odoo>
