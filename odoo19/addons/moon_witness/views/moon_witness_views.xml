<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_moon_witness_provenance_tree" model="ir.ui.view">
        <field name="name">moon.witness.provenance.tree</field>
        <field name="model">moon.witness.provenance</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="source_id"/>
                <field name="source_reference"/>
                <field name="revision"/>
                <field name="checksum"/>
            </list>
        </field>
    </record>

    <record id="view_moon_witness_source_tree" model="ir.ui.view">
        <field name="name">moon.witness.source.tree</field>
        <field name="model">moon.witness.source</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="stable_key"/>
                <field name="source_class"/>
                <field name="corpus"/>
                <field name="edition"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_moon_witness_source_form" model="ir.ui.view">
        <field name="name">moon.witness.source.form</field>
        <field name="model">moon.witness.source</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="stable_key"/>
                        <field name="source_class"/>
                        <field name="publisher"/>
                        <field name="corpus"/>
                        <field name="edition"/>
                        <field name="revision"/>
                        <field name="company_id"/>
                        <field name="active"/>
                    </group>
                    <field name="source_url"/>
                    <field name="license"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_moon_witness_artifact_tree" model="ir.ui.view">
        <field name="name">moon.witness.artifact.tree</field>
        <field name="model">moon.witness.artifact</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="source_id"/>
                <field name="revision_label"/>
                <field name="sha256"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <record id="view_moon_witness_passage_tree" model="ir.ui.view">
        <field name="name">moon.witness.passage.tree</field>
        <field name="model">moon.witness.passage</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="source_id"/>
                <field name="passage_type"/>
                <field name="canonical_reference"/>
                <field name="sequence"/>
            </list>
        </field>
    </record>

    <record id="action_moon_witness_sources" model="ir.actions.act_window">
        <field name="name">Sources</field>
        <field name="res_model">moon.witness.source</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_moon_witness_provenance" model="ir.actions.act_window">
        <field name="name">Provenance</field>
        <field name="res_model">moon.witness.provenance</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_moon_witness_passages" model="ir.actions.act_window">
        <field name="name">Passages</field>
        <field name="res_model">moon.witness.passage</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_moon_witness_root" name="Moon Witness" sequence="50" groups="base.group_user" web_icon="moon_witness,static/description/icon.png"/>
    <menuitem id="menu_moon_witness_sources" name="Sources" parent="menu_moon_witness_root" action="action_moon_witness_sources" sequence="10" groups="base.group_user"/>
    <menuitem id="menu_moon_witness_provenance" name="Provenance" parent="menu_moon_witness_root" action="action_moon_witness_provenance" sequence="15" groups="base.group_user"/>
    <menuitem id="menu_moon_witness_passages" name="Passages" parent="menu_moon_witness_root" action="action_moon_witness_passages" sequence="20" groups="base.group_user"/>
</odoo>
