<odoo>
    <record id="view_moon_myth_evidence_tree" model="ir.ui.view">
        <field name="name">moon.myth.evidence.tree</field>
        <field name="model">moon.myth.evidence</field>
        <field name="arch" type="xml">
            <list string="Audit Evidence Ledger">
                <field name="name"/>
                <field name="evidence_type"/>
                <field name="observation_id"/>
                <field name="url" widget="url"/>
            </list>
        </field>
    </record>

    <record id="view_moon_myth_evidence_form" model="ir.ui.view">
        <field name="name">moon.myth.evidence.form</field>
        <field name="model">moon.myth.evidence</field>
        <field name="arch" type="xml">
            <form string="Evidence Record">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Evidence Title"/>
                        <h1>
                            <field name="name" placeholder="e.g. BMKG Official Release"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="evidence_type"/>
                            <field name="observation_id"/>
                        </group>
                        <group>
                            <field name="url" widget="url"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description &amp; Key Excerpts">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_moon_myth_evidence" model="ir.actions.act_window">
        <field name="name">Evidence Ledger</field>
        <field name="res_model">moon.myth.evidence</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
