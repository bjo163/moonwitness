<odoo>
    <record id="view_moon_myth_issue_tree" model="ir.ui.view">
        <field name="name">moon.myth.issue.tree</field>
        <field name="model">moon.myth.issue</field>
        <field name="arch" type="xml">
            <list string="Tauhid Clarification Register">
                <field name="code"/>
                <field name="name"/>
                <field name="myth_id"/>
                <field name="target"/>
                <field name="priority"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <record id="view_moon_myth_issue_form" model="ir.ui.view">
        <field name="name">moon.myth.issue.form</field>
        <field name="model">moon.myth.issue</field>
        <field name="arch" type="xml">
            <form string="Clarification Issue">
                <sheet>
                    <div class="oe_title">
                        <label for="code" string="Issue ID"/>
                        <h1>
                            <field name="code" placeholder="e.g. TAU-01"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="myth_id"/>
                            <field name="target"/>
                        </group>
                        <group>
                            <field name="priority"/>
                            <field name="status"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Theological Resolution &amp; Guidance">
                            <field name="resolution" placeholder="Guidance on separating cultural identity from worship..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_moon_myth_issue" model="ir.actions.act_window">
        <field name="name">Tauhid Issues Register</field>
        <field name="res_model">moon.myth.issue</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
