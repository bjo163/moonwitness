<odoo>
    <record id="view_moon_myth_candidate_tree" model="ir.ui.view">
        <field name="name">moon.myth.candidate.tree</field>
        <field name="model">moon.myth.candidate</field>
        <field name="arch" type="xml">
            <list string="Autonomous Mythos Candidates">
                <field name="name"/>
                <field name="publisher"/>
                <field name="discovered_date"/>
                <field name="extracted_myth_name"/>
                <field name="extracted_location"/>
                <field name="extracted_tauhid_gap" widget="percentage"/>
                <field name="state" 
                       widget="badge" 
                       decoration-info="state == 'DISCOVERED'" 
                       decoration-warning="state == 'ANALYZED'" 
                       decoration-success="state == 'PROMOTED'" 
                       decoration-muted="state == 'REJECTED'"/>
            </list>
        </field>
    </record>

    <record id="view_moon_myth_candidate_form" model="ir.ui.view">
        <field name="name">moon.myth.candidate.form</field>
        <field name="model">moon.myth.candidate</field>
        <field name="arch" type="xml">
            <form string="Scout Candidate">
                <header>
                    <button name="action_analyze_with_ai" 
                            string="Analyze with AI" 
                            type="object" 
                            class="btn-primary" 
                            invisible="state in ('PROMOTED', 'REJECTED')"/>
                    <button name="action_promote_to_observation" 
                            string="Promote to Observation" 
                            type="object" 
                            class="btn-success" 
                            invisible="state != 'ANALYZED'"/>
                    <field name="state" widget="statusbar" statusbar_visible="DISCOVERED,ANALYZED,PROMOTED"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Article / Finding Title"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Source Provenance">
                            <field name="source_url" widget="url"/>
                            <field name="publisher"/>
                            <field name="discovered_date"/>
                        </group>
                        <group string="Master Linkage (Once Promoted)">
                            <field name="myth_id" readonly="1"/>
                            <field name="observation_id" readonly="1"/>
                        </group>
                    </group>

                    <group string="AI Intelligence Extraction" invisible="state == 'DISCOVERED'">
                        <group>
                            <field name="extracted_myth_name"/>
                            <field name="extracted_category"/>
                            <field name="extracted_location"/>
                            <field name="extracted_actor"/>
                        </group>
                        <group>
                            <field name="extracted_evidence_score"/>
                            <field name="extracted_tauhid_gap"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Practice Summary" invisible="state == 'DISCOVERED'">
                            <field name="extracted_summary" placeholder="Summary extracted by AI..."/>
                        </page>
                        <page string="Tauhid Critique (AI)" invisible="state == 'DISCOVERED'">
                            <field name="theological_critique" placeholder="Theological analysis by AI..."/>
                        </page>
                        <page string="Raw Snippet">
                            <field name="raw_snippet"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Server Action to Trigger Autonomous Scouting -->
    <record id="action_server_scout_news" model="ir.actions.server">
        <field name="name">Run Autonomous Scout (Crawl News)</field>
        <field name="model_id" ref="model_moon_myth_candidate"/>
        <field name="binding_model_id" ref="model_moon_myth_candidate"/>
        <field name="state">code</field>
        <field name="code">
            model.autonomous_scout_news()
        </field>
    </record>

    <record id="action_moon_myth_candidate" model="ir.actions.act_window">
        <field name="name">Scout Candidate Pipeline</field>
        <field name="res_model">moon.myth.candidate</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
