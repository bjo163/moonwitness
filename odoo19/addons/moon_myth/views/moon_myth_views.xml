<odoo>
    <record id="view_moon_myth_tree" model="ir.ui.view">
        <field name="name">moon.myth.tree</field>
        <field name="model">moon.myth</field>
        <field name="arch" type="xml">
            <list string="Mythos Database">
                <field name="code"/>
                <field name="name"/>
                <field name="category"/>
                <field name="theological_status"/>
                <field name="observation_count"/>
                <field name="average_tauhid_gap" widget="percentage"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_moon_myth_form" model="ir.ui.view">
        <field name="name">moon.myth.form</field>
        <field name="model">moon.myth</field>
        <field name="arch" type="xml">
            <form string="Mythos Entity">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Mythos / Practice Name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Pemujaan Dewi Sri"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" placeholder="e.g. MYTH-SRI"/>
                            <field name="category"/>
                            <field name="theological_status"/>
                        </group>
                        <group>
                            <field name="observation_count"/>
                            <field name="average_tauhid_gap"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Overview &amp; Background">
                            <field name="description" placeholder="Historical background and cultural description..."/>
                        </page>
                        <page string="Tauhid Critique &amp; Analysis">
                            <field name="theological_critique" placeholder="Analysis through Islamic monotheism (Tauhid) and revelation..."/>
                        </page>
                        <page string="Field Observations">
                            <field name="observation_ids">
                                <list>
                                    <field name="obs_code"/>
                                    <field name="name"/>
                                    <field name="date_display"/>
                                    <field name="location"/>
                                    <field name="actor"/>
                                    <field name="evidence_score"/>
                                    <field name="tauhid_gap"/>
                                    <field name="causality"/>
                                </list>
                            </field>
                        </page>
                        <page string="Clarification Issues">
                            <field name="issue_ids">
                                <list>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="priority"/>
                                    <field name="status"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_moon_myth" model="ir.actions.act_window">
        <field name="name">Mythos Database</field>
        <field name="res_model">moon.myth</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
