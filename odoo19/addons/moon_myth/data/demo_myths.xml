<odoo>
    <!-- Master Myths -->
    <record id="myth_dewi_sri" model="moon.myth">
        <field name="name">Pemujaan Dewi Sri (Dewi Padi &amp; Kesuburan)</field>
        <field name="code">MYTH-DEWI-SRI</field>
        <field name="category">AGRARIAN</field>
        <field name="theological_status">UNDER_REVIEW</field>
        <field name="description">Penghormatan terhadap figur mitologis Dewi Sri sebagai penjaga kesuburan sawah dan panen di tanah Jawa dan Bali.</field>
        <field name="theological_critique">Dalam Tauhid Islam, rezeki, tumbuhnya tanaman, dan kesuburan bumi mutlak merupakan rububiyyah Allah Ta'ala (QS. Al-Waqi'ah: 63-65). Figur Dewi Sri perlu didefinisikan secara jernih apakah simbol budaya atau obyek permohonan spiritual.</field>
    </record>

    <record id="myth_nyadran_karo" model="moon.myth">
        <field name="name">Tradisi Nyadran &amp; Hari Raya Karo</field>
        <field name="code">MYTH-NYADRAN-KARO</field>
        <field name="category">ANCESTOR</field>
        <field name="theological_status">CULTURAL_SYMBOL</field>
        <field name="description">Ritual komunal masyarakat adat Tengger dan pedesaan Jawa untuk ziarah dan penghormatan leluhur menjelang atau saat siklus tahunan.</field>
        <field name="theological_critique">Mendoakan leluhur dan silaturahmi adalah amal baik. Namun bila disertai keyakinan arwah leluhur memiliki daya memberi berkah atau mudarat independen, hal itu menyalahi Tauhid uluhiyyah.</field>
    </record>

    <record id="myth_pantai_selatan" model="moon.myth">
        <field name="name">Larung Sesaji &amp; Mitologi Laut Selatan</field>
        <field name="code">MYTH-PANTAI-SELATAN</field>
        <field name="category">MARITIME</field>
        <field name="theological_status">TAUHID_VIOLATION</field>
        <field name="description">Persembahan sesaji ke laut selatan untuk memohon keselamatan dan tolak bala kepada penguasa gaib laut selatan.</field>
        <field name="theological_critique">Menyembelih atau melarung sesaji kepada selain Allah untuk mencari keselamatan adalah bentuk syirik akbar dalam aspek ibadah dan perlindungan (isti'adzah).</field>
    </record>

