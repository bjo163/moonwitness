    <!-- Clarification Issues -->
    <record id="issue_tau_01" model="moon.myth.issue">
        <field name="code">TAU-01</field>
        <field name="name">Dewi Sri: Simbol Budaya atau Objek Sembahan?</field>
        <field name="myth_id" ref="myth_dewi_sri"/>
        <field name="target">Dewi Sri / Karanganyar</field>
        <field name="priority">HIGH</field>
        <field name="status">Verified practice; theological clarification required</field>
        <field name="resolution">Pisahkan simbolisme budaya dari ibadah/sembahan. Pastikan keyakinan tauhid bahwa sumber mutlak kesuburan dan rezeki hanya milik Allah Yang Maha Esa.</field>
    </record>

