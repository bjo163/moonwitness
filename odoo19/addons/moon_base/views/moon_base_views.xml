<odoo>
  <record id="view_moon_external_identity_tree" model="ir.ui.view">
    <field name="name">moon.external.identity.tree</field>
    <field name="model">moon.external.identity</field>
    <field name="arch" type="xml">
      <list><field name="provider"/><field name="external_key"/><field name="model_name"/><field name="res_id"/><field name="company_id"/><field name="active"/></list>
    </field>
  </record>
  <record id="view_moon_external_identity_form" model="ir.ui.view">
    <field name="name">moon.external.identity.form</field>
    <field name="model">moon.external.identity</field>
    <field name="arch" type="xml">
      <form><sheet><group><field name="provider"/><field name="external_key"/><field name="model_name"/><field name="res_id"/><field name="company_id"/><field name="active"/></group><field name="note"/></sheet></form>
    </field>
  </record>
</odoo>
