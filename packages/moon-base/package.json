{
  "name": "@moon/base",
  "version": "0.1.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "files": ["dist"],
  "scripts": {
    "build": "tsc && node -e \"const fs=require('fs');const src='src/data',dst='dist/data';if(fs.existsSync(src)){if(fs.existsSync(dst))fs.rmSync(dst,{recursive:true});fs.cpSync(src,dst,{recursive:true})}\"",
    "seed:verify": "node src/scripts/verify-seed.mjs"
  },
  "dependencies": {
    "@moon/orm": "workspace:*",
    "bcryptjs": "^3.0.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.17.0",
    "typescript": "^5.5.4"
  }
}
