{
  "roles": [
    {
      "name": "Admin",
      "description": "System Administrator with full management access"
    },
    {
      "name": "Operator",
      "description": "Terminal Operator for monitoring and telemetry"
    },
    {
      "name": "User",
      "description": "Standard authenticated member"
    },
    {
      "name": "Public",
      "description": "Unauthenticated public guest"
    }
