# MoonWitness — production environment
# Copy to .env.production, then fill in ONLY these 2 values.
# Everything else has safe defaults in docker-compose.yml.
#
# Postgres/Redis live on an internal-only Docker network (no host ports),
# so their credentials default to "moonwitness" and need no entry here.

# 1. JWT signing secret — generate with:
#    node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_HIGH_ENTROPY_64_BYTE_HEX_SECRET_STRING_HERE

# 2. Public API URL as seen by browsers (baked into the web builds)
PUBLIC_API_URL=https://api.moonwitness.os

# ── Optional overrides (uncomment only if you need them) ─────────────────────
# POSTGRES_USER=moonwitness
# POSTGRES_PASSWORD=moonwitness
# POSTGRES_DB=moonwitness
# REDIS_PASSWORD=moonwitness
# DATABASE_URL=postgres://user:pass@postgres:5432/moonwitness
# REDIS_URL=redis://:pass@redis:6379
# WEB_PORT=3000
# COMMAND_CENTER_PORT=3001
# API_PORT=4000
# CELESTIAL_ENGINE_PORT=8001
# AI_AGENT_PORT=8002
# ALLOWED_ORIGINS=https://moonwitness.os,https://command.moonwitness.os
# COOKIE_DOMAIN=.moonwitness.os