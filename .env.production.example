# ◈ MOONWITNESS OS V9.5 — ENTERPRISE PRODUCTION ENVIRONMENT BLUEPRINT
# Copy to .env.production on the host server

# ── 1. GLOBAL RUNTIME & PORTS ────────────────────────────────────────────────
NODE_ENV=production
PORT_WEB=3000
PORT_COMMAND_CENTER=3001
PORT_API=4000

# ── 2. DATABASE & REDIS INFRASTRUCTURE ──────────────────────────────────────
# PostgreSQL 16+ with pgvector 0.8+. All four values are required by Docker Compose.
# DATABASE_URL must target the Compose service hostname `postgres`, not 127.0.0.1.
# URL-encode credentials in DATABASE_URL when they contain reserved URL characters.
POSTGRES_USER=moonwitness
POSTGRES_PASSWORD=REPLACE_WITH_UNIQUE_POSTGRES_PASSWORD
POSTGRES_DB=moonwitness
DATABASE_URL=postgres://moonwitness:REPLACE_WITH_URL_ENCODED_POSTGRES_PASSWORD@postgres:5432/moonwitness
DB_POOL_MIN=5
DB_POOL_MAX=25
DB_SSL=false

# Redis 7+ for high-speed cache & worker queue. Password is mandatory in production.
# URL-encode the password in REDIS_URL when it contains reserved URL characters.
REDIS_PASSWORD=REPLACE_WITH_UNIQUE_REDIS_PASSWORD
REDIS_URL=redis://:REPLACE_WITH_URL_ENCODED_REDIS_PASSWORD@redis:6379

# ── 3. AUTHENTICATION & CRYPTOGRAPHY ─────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_HIGH_ENTROPY_64_BYTE_HEX_SECRET_STRING_HERE
JWT_EXPIRES_IN=7d
COOKIE_SECRET=REPLACE_WITH_SECURE_COOKIE_SIGNING_SECRET_HERE
COOKIE_DOMAIN=.moonwitness.os
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax

# ── 4. CROSS-ORIGIN & DOMAIN MAPPINGS ───────────────────────────────────────
PUBLIC_WEB_URL=https://moonwitness.os
PUBLIC_COMMAND_CENTER_URL=https://command.moonwitness.os
PUBLIC_API_URL=https://api.moonwitness.os
ALLOWED_ORIGINS=https://moonwitness.os,https://command.moonwitness.os,https://api.moonwitness.os

# ── 5. PERFORMANCE & TELEMETRY ───────────────────────────────────────────────
ENABLE_TELEMETRY=true
LOG_LEVEL=info
CRASH_REPORTER_DISPATCH=true
MAX_REQUEST_BODY_MB=10
