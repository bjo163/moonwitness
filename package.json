{
  "name": "moonwitness",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "dev": "turbo dev --parallel",
    "dev:all": "turbo dev --filter=web --filter=command-center --filter=api --parallel",
    "dev:web": "turbo dev --filter=web",
    "dev:admin": "turbo dev --filter=command-center",
    "dev:api": "turbo dev --filter=api",
    "db:install": "pnpm --filter=api db:install",
    "db:seed": "pnpm --filter=api db:seed",
    "db:demo": "pnpm --filter=api db:demo",
    "build": "turbo build",
    "build:all": "turbo build",
    "clean": "turbo clean && rimraf node_modules",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:rules": "node scripts/audit-rules.mjs",
    "audit:packages": "node scripts/audit-rules.mjs",
    "audit:ci": "node scripts/audit-rules.mjs && turbo typecheck && vitest run"
  },
  "devDependencies": {
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint-plugin-unused-imports": "^4.4.1",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "turbo": "^2.9.18",
    "typescript": "^5",
    "vitest": "^1.6.1"
  },
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=20"
  }
}
