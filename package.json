{
  "name": "moonwitness",
  "version": "0.3.1",
  "private": true,
  "scripts": {
    "dev": "turbo dev --filter=web --filter=command-center --filter=api --parallel",
    "dev:all": "turbo dev --filter=web --filter=command-center --filter=api --parallel",
    "dev:web": "turbo dev --filter=web",
    "dev:admin": "turbo dev --filter=command-center",
    "dev:api": "turbo dev --filter=api",
    "win:dev:up": "node scripts/win-dev-up.mjs",
    "win:dev:down": "node scripts/win-dev-down.mjs",
    "db:install": "pnpm --filter=api db:install",
    "db:seed": "pnpm --filter=api db:seed",
    "db:demo": "pnpm --filter=api db:demo",
    "db:sync-status": "node scripts/db-sync.mjs --status",
    "db:sync-up": "node scripts/db-sync.mjs --up",
    "db:sync-down": "node scripts/db-sync.mjs --down",
    "build": "turbo build",
    "build:all": "turbo build",
    "clean": "turbo clean && rimraf node_modules",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "certify:knowledge": "vitest run packages/moon-witness/tests/knowledge-certification.test.ts",
    "release:check": "node scripts/release-check.mjs",
    "release:verify": "node scripts/release-check.mjs && pnpm contracts:verify && pnpm certify:knowledge && pnpm audit:ci",
    "corpus:sync": "pnpm --filter=@moon/witness exec tsx scripts/sync-corpus.ts",
    "contracts:export": "pnpm --filter=api exec tsx ../../scripts/export-contracts.ts",
    "contracts:verify": "pnpm --filter=api exec tsx ../../scripts/verify-contracts.ts",
    "contracts:generate:python": "pnpm --filter=api exec tsx ../../scripts/generate-python-contracts.ts",
    "audit:rules": "node scripts/audit.mjs",
    "audit:packages": "node scripts/audit.mjs",
    "audit:collectors": "node scripts/audit.mjs --collector-json",
    "audit:umbrella": "node scripts/umbrella-audit.mjs --write",
    "audit:umbrella:json": "node scripts/umbrella-audit.mjs --json",
    "audit:umbrella:validate": "node scripts/umbrella-audit.mjs --validate",
    "audit:umbrella:check": "node scripts/umbrella-audit.mjs --check",
    "audit:umbrella:render": "node scripts/umbrella-render-cli.mjs",
    "audit:umbrella:render:check": "node scripts/umbrella-render-cli.mjs --check",
    "audit:umbrella:dry-run": "node scripts/umbrella-audit.mjs --fix-safe --dry-run",
    "audit:umbrella:fix-safe": "node scripts/umbrella-audit.mjs --fix-safe",
    "audit:umbrella:certify": "node scripts/umbrella-certify.mjs",
    "audit:umbrella:ci": "node scripts/umbrella-audit.mjs --ci-evidence=.audit/runtime/ci-evidence.json --write --validate",
    "audit:ci": "node scripts/audit.mjs && node scripts/umbrella-audit.mjs --validate && turbo typecheck && vitest run",
    "test:scripts": "vitest run scripts",
    "deploy:docker": "node scripts/deploy-docker.mjs",
    "deploy:docker:build": "node scripts/deploy-docker.mjs --build-only",
    "deploy:docker:down": "node scripts/deploy-docker.mjs --down",
    "deploy:docker:status": "node scripts/deploy-docker.mjs --status",
    "deploy:docker:logs": "node scripts/deploy-docker.mjs --logs",
    "deploy:docker:restart": "node scripts/deploy-docker.mjs --restart"
  },
  "devDependencies": {
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint-plugin-unused-imports": "^4.4.1",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "turbo": "^2.9.18",
    "typescript": "^5",
    "vitest": "^1.6.1"
  },
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=20"
  }
}
