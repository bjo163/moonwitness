# Database Configuration
# Local-First SQLite (default if DATABASE_URL is omitted in dev):
# DATABASE_URL=sqlite://./data/moonwitness.dev.db
# Or PostgreSQL for production / external sync:
DATABASE_URL=postgres://postgres:postgres@localhost:5432/moonwitness
JWT_SECRET=your-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ISSUER=moonwitness
JWT_AUDIENCE=moonwitness-api
JWT_ACCESS_TOKEN_TTL=7d
JWT_CLOCK_TOLERANCE_SECONDS=60
WEB_PORT=3000
COMMAND_CENTER_PORT=3001
API_PORT=4000
CELESTIAL_ENGINE_PORT=8001
AI_AGENT_PORT=8002

# Bootstrap Initial Superuser Credentials
BOOTSTRAP_ADMIN_EMAIL=admin@moonwitness.org
BOOTSTRAP_ADMIN_PASSWORD=your-secure-admin-password

# Optional Mail Configuration (for password reset / OTP)
SMTP_SERVICE=gmail
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-app-password
SMTP_FROM="MoonWitness Security" <noreply@example.com>

